<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="navigrid_world">

    <!-- =========================================================
         GAZEBO SYSTEMS
         ========================================================= -->

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- =========================================================
         SCENE
         ========================================================= -->

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.70 0.70 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- =========================================================
         SUN
         ========================================================= -->

    <light name="sun" type="directional">

      <cast_shadows>true</cast_shadows>

      <pose>0 0 20 0 0 0</pose>

      <diffuse>0.8 0.8 0.8 1</diffuse>

      <specular>0.2 0.2 0.2 1</specular>

      <direction>-0.5 0.5 -1</direction>

    </light>


    <!-- =========================================================
         30m x 30m ARENA FLOOR
         ========================================================= -->

    <model name="arena_floor">

      <static>true</static>

      <link name="floor">

        <collision name="collision">

          <geometry>

            <box>
              <size>30 30 0.1</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>30 30 0.1</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>0 0 -0.05 0 0 0</pose>

    </model>


    <!-- =========================================================
         RAMP A -> B
         8m LONG
         4m WIDE
         ========================================================= -->

    <model name="ramp_A_to_B">

      <static>true</static>

      <link name="ramp_link">

        <collision name="ramp_collision">

          <geometry>

            <box>
              <size>8 4 0.8</size>
            </box>

          </geometry>

        </collision>


        <visual name="ramp_visual">

          <geometry>

            <box>
              <size>8 4 0.8</size>
            </box>

          </geometry>

        </visual>

      </link>

      <!--
        Ramp approximately 11.5 degrees.
        Low end begins close to ground.
      -->

      <pose>
        4 8 1.19
        0 -0.20 0
      </pose>

    </model>


    <!-- =========================================================
         ZIG-ZAG ROUTE
         Visual route markers on ground
         ========================================================= -->


    <model name="zigzag_segment_1">

      <static>true</static>

      <link name="segment">

        <visual name="visual">

          <geometry>

            <box>
              <size>5 0.08 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>-9 -8 0.02 0 0 0.0</pose>

    </model>


    <model name="zigzag_segment_2">

      <static>true</static>

      <link name="segment">

        <visual name="visual">

          <geometry>

            <box>
              <size>5 0.08 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>-4 -6 0.02 0 0 0.785</pose>

    </model>


    <model name="zigzag_segment_3">

      <static>true</static>

      <link name="segment">

        <visual name="visual">

          <geometry>

            <box>
              <size>5 0.08 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>1 -4 0.02 0 0 -0.785</pose>

    </model>


    <model name="zigzag_segment_4">

      <static>true</static>

      <link name="segment">

        <visual name="visual">

          <geometry>

            <box>
              <size>5 0.08 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>6 -2 0.02 0 0 0.785</pose>

    </model>


    <model name="zigzag_segment_5">

      <static>true</static>

      <link name="segment">

        <visual name="visual">

          <geometry>

            <box>
              <size>4 0.08 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>10 0 0.02 0 0 -0.785</pose>

    </model>


    <!-- =========================================================
         RACK OBSTACLE 1
         ========================================================= -->

    <model name="rack_1">

      <static>true</static>

      <link name="rack_link">

        <collision name="collision">

          <geometry>

            <box>
              <size>2.5 1.2 2.0</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>2.5 1.2 2.0</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>-6 4 1.0 0 0 0</pose>

    </model>


    <!-- =========================================================
         RACK OBSTACLE 2
         ========================================================= -->

    <model name="rack_2">

      <static>true</static>

      <link name="rack_link">

        <collision name="collision">

          <geometry>

            <box>
              <size>2.5 1.2 2.0</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>2.5 1.2 2.0</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>8 4 1.0 0 0 0</pose>

    </model>


    <!-- =========================================================
         RACK OBSTACLE 3
         ========================================================= -->

    <model name="rack_3">

      <static>true</static>

      <link name="rack_link">

        <collision name="collision">

          <geometry>

            <box>
              <size>2.5 1.2 2.0</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>2.5 1.2 2.0</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>-7 -2 1.0 0 0 0</pose>

    </model>


    <!-- =========================================================
         PILLAR 1
         ========================================================= -->

    <model name="pillar_1">

      <static>true</static>

      <link name="pillar_link">

        <collision name="collision">

          <geometry>

            <cylinder>
              <radius>0.45</radius>
              <length>2.5</length>
            </cylinder>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <cylinder>
              <radius>0.45</radius>
              <length>2.5</length>
            </cylinder>

          </geometry>

        </visual>

      </link>

      <pose>2 5 1.25 0 0 0</pose>

    </model>


    <!-- =========================================================
         PILLAR 2
         ========================================================= -->

    <model name="pillar_2">

      <static>true</static>

      <link name="pillar_link">

        <collision name="collision">

          <geometry>

            <cylinder>
              <radius>0.45</radius>
              <length>2.5</length>
            </cylinder>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <cylinder>
              <radius>0.45</radius>
              <length>2.5</length>
            </cylinder>

          </geometry>

        </visual>

      </link>

      <pose>5 5 1.25 0 0 0</pose>

    </model>


    <!-- =========================================================
         CHOKEPOINT LEFT BARRIER
         ========================================================= -->

    <model name="chokepoint_left">

      <static>true</static>

      <link name="barrier_link">

        <collision name="collision">

          <geometry>

            <box>
              <size>4 0.6 1.5</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>4 0.6 1.5</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>0 -7 0.75 0 0 0</pose>

    </model>


    <!-- =========================================================
         CHOKEPOINT RIGHT BARRIER
         ========================================================= -->

    <model name="chokepoint_right">

      <static>true</static>

      <link name="barrier_link">

        <collision name="collision">

          <geometry>

            <box>
              <size>4 0.6 1.5</size>
            </box>

          </geometry>

        </collision>


        <visual name="visual">

          <geometry>

            <box>
              <size>4 0.6 1.5</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>0 -11 0.75 0 0 0</pose>

    </model>


    <!-- =========================================================
         START AREA MARKER
         ========================================================= -->

    <model name="start_area">

      <static>true</static>

      <link name="marker">

        <visual name="visual">

          <geometry>

            <box>
              <size>3 3 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>-12 -12 0.02 0 0 0</pose>

    </model>


    <!-- =========================================================
         GOAL AREA MARKER
         ========================================================= -->

    <model name="goal_area">

      <static>true</static>

      <link name="marker">

        <visual name="visual">

          <geometry>

            <box>
              <size>3 3 0.02</size>
            </box>

          </geometry>

        </visual>

      </link>

      <pose>12 12 0.02 0 0 0</pose>

    </model>


  </world>

</sdf>
